# leghe.fantacalcio.it credentials
LEGA_EMAIL=
LEGA_PASSWORD=
LEGA_URL=https://leghe.fantacalcio.it/nome-della-tua-lega

# paths (defaults are fine, override only if needed)
FANTABOT_DATA_DIR=./data
FANTABOT_STORAGE_STATE=./data/storage_state.json

# safety switch — false means "log what I would do" only, no real submit/bid.
# flip to true only after a supervised dry run of `asta-bid` against a throwaway room.
FANTABOT_AUTO_ACT=false

# which lega this run manages — the l_id from docs/leghe-api.md.
# 4103937 = legamiallerotaie2, 3584692 = legamiallerotaie.
FANTABOT_LEAGUE_ID=

# local Postgres (docker compose up -d). The DSN's driver must stay +psycopg2:
# postgresql+asyncpg:// breaks `alembic upgrade head`.
# The two port values are read by docker-compose.yml as well as by Settings, so
# changing one here moves both the published port and the DSN fantabot dials.
FANTABOT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:54321/fantabot
FANTABOT_DB_HOST_PORT=54321
FANTABOT_ADMINER_HOST_PORT=18082

# encrypts the bearer token in league_tokens. Generate your own and paste it
# here — never commit a real value, and never pass a key on the command line
# (argv is visible in `ps` and persists in shell history):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation is re-login: `fantabot login` rewrites every row under the new key.
FANTABOT_ENCRYPTION_KEY=

# the JSON API behind leghe.fantacalcio.it — see docs/leghe-api.md
FANTABOT_APILEAGUE_BASE_URL=https://apileague.fantacalcio.it

# external stats/injuries/probable-lineups source — TBD, fill in once decided
STATS_SOURCE_BASE_URL=
STATS_SOURCE_API_KEY=

API_FOOTBALL_API_KEY=

# Agent backend for `news-fetch` and `mantra-grid`. Leave both blank to use the
# Claude Code OAuth subscription — the default, and the only backend where the
# WebSearch tool works at all (it runs server-side on Anthropic's API).
#
# Point FANTABOT_AGENT_BASE_URL at an Anthropic-compatible shim to route the
# fan-out elsewhere. Ollama's is the LOCAL daemon; ollama.com serves no
# /v1/messages, so cloud models go through the same local daemon with a
# ":cloud" model suffix and the daemon's own signed-in key:
#
#   FANTABOT_AGENT_BASE_URL=http://localhost:11434
#   FANTABOT_AGENT_AUTH_TOKEN=ollama
#   FANTABOT_AGENT_MODEL=deepseek-v4-flash:cloud
#   OLLAMA_CONTEXT_LENGTH=65536 ollama serve   # daemon side; 64k+ per Ollama docs
#
# FANTABOT_AGENT_MODEL must match the backend and is checked, not trusted: a
# claude-* id with a base URL set is refused, and so is a non-claude id without
# one. Both are the same cron-log-only failure otherwise.
#
# WebSearch, WebFetch and the json_schema output contract all survive the switch
# — verified 2026-08-26 on deepseek-v4-flash:cloud. Smoke-test any new backend
# with `news-fetch --limit 1` (no --write) anyway; the shim has to honour forced
# tool_choice for the structured output to come back at all.
FANTABOT_AGENT_BASE_URL=
FANTABOT_AGENT_AUTH_TOKEN=
FANTABOT_AGENT_MODEL=claude-sonnet-4-6-eaq-gf08h1
