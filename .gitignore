__pycache__/
*.pyc
.venv/
.env
# data/* and not data/ — git will not descend into an excluded directory, so a
# `!data/keep-me.csv` under a plain `data/` rule is silently inert. Excluding the
# contents instead is what makes the negations below actually work.
data/*
!data/.gitkeep
# Documentation, not data.
!data/README.md
# The news pipeline's output is the historical record: a past Wednesday cannot be
# regenerated, so it is tracked despite living under data/.
!data/player_sentiment_*.csv
# The two Mantra artefacts moved to src/fantabot/data/ in P11-6 -- they are the
# matcher's input, so they ship with the package. Not listed here: `data/*` carries a
# slash and is therefore anchored to this file's directory, so it never reached them.
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

docs/

# Database dumps. scripts/db_dump.sh refuses to write onto this volume at all,
# because a dump carries the league_tokens rows — encrypted, but still
# credentials — and the working tree is one `git add -A` from a commit, now with
# a remote to push it to. A dump asked for in the repo root is ignored instead.
*.dump
*.sql

# The Remotion project behind the full-screen animations in script.md.
# Renders land in out/ and are regenerable: `cd video && npx remotion render <id>`.
video/node_modules/
video/out/

# macOS + local scratch, never publish
.DS_Store
/out/
/script.md
/video/

# maintainer-only, never publish
/SPEC.md

# Task-0 capture tools — throwaway, and they carry the maintainer's own league/room/team
# ids (and a public Firebase web key). Kept local, never committed to a public repo.
scripts/capture_*.py
scripts/read_classic_lineup.py
